config_version=5
[application]
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
config/name="LISA"
config/version="2.2.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/opening.webp"
[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.026, 1)
[gui]
theme/default_font_multichannel_signed_distance_field=true
[audio]
driver/enable_input=false
